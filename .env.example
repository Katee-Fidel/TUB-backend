NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/tamasha-hub
CLIENT_URL=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_TICKET_SECRET=replace-with-a-third-long-random-secret
TICKET_TOKEN_EXPIRATION=180d
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=your-sandbox-app-consumer-key
DARAJA_CONSUMER_SECRET=your-sandbox-app-consumer-secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=your-daraja-passkey
# Must be a public URL owned by this API, never a Safaricom endpoint.
DARAJA_CALLBACK_URL=https://your-api.onrender.com/api/mpesa/callback
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
